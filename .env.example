# ── Clerk (frontend, safe to expose — it's a publishable key) ──────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Clerk secret — NOT used by the frontend build. Keep local only. ────────
CLERK_SECRET_KEY=sk_test_...

# ── AI Copilot — any OpenAI-compatible chat API — SERVER-SIDE only. ───────
# Read by the /api/assistant function and the local `vite dev` bridge.
# While unset, the copilot transparently uses its local rule-based engine.
# Get a key at https://kiraai.vn (or use Moonshot/OpenAI/OpenRouter/etc.).
AI_API_KEY=IFM-...
# Full chat/completions URL — default: https://kiraai.vn/api/v1/chat/completions
# AI_BASE_URL=https://kiraai.vn/api/v1/chat/completions
# Model id — default: kira-3.5-flash
# AI_MODEL=kira-3.5-flash
#
# Legacy names still accepted: KIMI_API_KEY / MOONSHOT_API_KEY / VITE_KIMI_API_KEY,
# KIMI_BASE_URL, KIMI_MODEL.
