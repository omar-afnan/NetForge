# ── Clerk (frontend, safe to expose — it's a publishable key) ──────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Clerk secret — NOT used by the frontend build. Keep local only. ────────
CLERK_SECRET_KEY=sk_test_...

# ── AI Copilot (Kimi / Moonshot) — SERVER-SIDE only. ───────────────────────
# Read exclusively by the /api/assistant Vercel serverless function.
# NEVER prefix with VITE_ — that would bundle the key into public client JS.
# While this is unset, the copilot transparently uses its local rule-based
# engine and everything still works.
KIMI_API_KEY=sk-...
# Optional override (default: moonshot-v1-8k)
# KIMI_MODEL=moonshot-v1-8k
