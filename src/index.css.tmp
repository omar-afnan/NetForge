@import "tailwindcss";

:root {
  --bg-root: #060a0f;
  --bg-panel: #0c1219;
  --bg-elevated: #121a24;
  --bg-inset: #080d13;
  --border: #1e2a38;
  --border-bright: #2f4358;
  --text-primary: #e8eef5;
  --text-secondary: #9aadc4;
  --text-dim: #5f7389;
  --accent-link: #2ec8f0;
  --accent-link-dim: rgba(46, 200, 240, 0.15);
  --accent-amber: #f0b429;
  --status-up: #34d399;
  --status-down: #f87171;
  --status-warn: #fbbf24;
  --glow-cyan: 0 0 24px rgba(46, 200, 240, 0.12);
  --glow-panel: 0 1px 0 rgba(255, 255, 255, 0.04) inset;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
  margin: 0;
}

body {
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  background:
    radial-gradient(ellipse 80% 50% at 50% -10%, rgba(46, 200, 240, 0.08), transparent),
    radial-gradient(ellipse 60% 40% at 100% 100%, rgba(52, 211, 153, 0.04), transparent),
    var(--bg-root);
  color: var(--text-primary);
  font-size: 13px;
  -webkit-font-smoothing: antialiased;
}

body.glow-off {
  --glow-cyan: none;
  --glow-panel: none;
}

.font-data {
  font-family: 'Cascadia Code', 'Consolas', 'Courier New', monospace;
}

.panel {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  box-shadow: var(--glow-panel);
}

.panel-header {
  border-bottom: 1px solid var(--border);
  background: linear-gradient(180deg, var(--bg-elevated) 0%, var(--bg-panel) 100%);
  padding: 8px 12px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--text-secondary);
}

.grid-bg {
  background-color: var(--bg-inset);
}

.grid-bg.show-grid {
  background-image:
    linear-gradient(rgba(46, 200, 240, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(46, 200, 240, 0.06) 1px, transparent 1px);
  background-size: 28px 28px;
}

.grid-bg::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: radial-gradient(ellipse at center, transparent 40%, rgba(6, 10, 15, 0.5) 100%);
}

.status-up {
  color: var(--status-up);
}

.status-down {
  color: var(--status-down);
}

.status-warn {
  color: var(--status-warn);
}

.nav-active {
  border-color: var(--border-bright) !important;
  background: linear-gradient(90deg, var(--accent-link-dim) 0%, var(--bg-elevated) 100%) !important;
  color: var(--text-primary) !important;
  box-shadow: inset 3px 0 0 var(--accent-link);
}

.stat-card {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--stat-accent, var(--accent-link));
}

.stat-card::after {
  content: '';
  position: absolute;
  top: -40px;
  right: -40px;
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: var(--stat-accent, var(--accent-link));
  opacity: 0.06;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  border: 1px solid var(--border-bright);
  background: var(--bg-elevated);
  color: var(--text-secondary);
}

.badge-cyan {
  border-color: rgba(46, 200, 240, 0.35);
  color: var(--accent-link);
  background: rgba(46, 200, 240, 0.08);
}

.badge-green {
  border-color: rgba(52, 211, 153, 0.35);
  color: var(--status-up);
  background: rgba(52, 211, 153, 0.08);
}

.difficulty-beginner {
  border-color: rgba(52, 211, 153, 0.35);
  color: var(--status-up);
  background: rgba(52, 211, 153, 0.08);
}

.difficulty-intermediate {
  border-color: rgba(240, 180, 41, 0.35);
  color: var(--accent-amber);
  background: rgba(240, 180, 41, 0.08);
}

.difficulty-advanced {
  border-color: rgba(248, 113, 113, 0.35);
  color: var(--status-down);
  background: rgba(248, 113, 113, 0.08);
}

.btn-primary {
  padding: 6px 12px;
  border: 1px solid rgba(46, 200, 240, 0.4);
  background: rgba(46, 200, 240, 0.12);
  color: var(--accent-link);
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
}

.btn-primary:hover {
  background: rgba(46, 200, 240, 0.2);
  border-color: var(--accent-link);
}

.btn-ghost {
  padding: 4px 8px;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text-dim);
  cursor: pointer;
  transition: color 0.15s, border-color 0.15s;
}

.btn-ghost:hover {
  color: var(--text-secondary);
  border-color: var(--border-bright);
}

.select-field {
  padding: 5px 8px;
  border: 1px solid var(--border-bright);
  background: var(--bg-root);
  color: var(--text-primary);
  outline: none;
}

.select-field:focus {
  border-color: var(--accent-link);
}

.select-field:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.pulse-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--status-up);
  box-shadow: 0 0 6px var(--status-up);
  animation: pulse-dot 2s ease-in-out infinite;
}

@keyframes pulse-dot {

  0%,
  100% {
    opacity: 1;
  }

  50% {
    opacity: 0.45;
  }
}

@keyframes link-pulse {

  0%,
  100% {
    stroke-opacity: 0.45;
  }

  50% {
    stroke-opacity: 0.85;
  }
}

.link-pulse {
  animation: link-pulse 2.5s ease-in-out infinite;
}

@keyframes link-flow {
  from {
    stroke-dashoffset: 0;
  }

  to {
    stroke-dashoffset: -120.4;
  }
}

/* Packet dots flowing along a cable. Dash period is 30.1 (0.1 + 30),
   and the keyframe offset is 4 periods, so the loop is seamless. */
.link-flow {
  stroke-linecap: round;
  animation: link-flow 2.2s linear infinite;
}

.table-compact td,
.table-compact th {
  padding-top: 4px !important;
  padding-bottom: 4px !important;
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-thumb {
  background: #243040;
  border: 1px solid var(--border);
}

::-webkit-scrollbar-track {
  background: var(--bg-inset);
}

/* ============================================================
   App layout - topology canvas and diagnostics panel are strict
   separate layout regions. Edge geometry is computed inside the
   measured canvas box only, so no line can ever render under,
   outside, or beyond the diagnostics sidebar.
   ============================================================ */

html,
body {
  overflow: hidden;
}

.app-shell {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

.app-shell-body {
  display: flex;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.app-shell-content {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 0;
  flex-direction: column;
  overflow: hidden;
}

.netforge-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  width: 100%;
  min-width: 0;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.netforge-layout.with-diagnostics {
  grid-template-columns: minmax(0, 1fr) 360px;
}

.topology-panel {
  position: relative;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.topology-column {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

.topology-view {
  flex: 1 1 0;
  min-height: 0;
  overflow: hidden;
}

.console-dock {
  flex: none;
  height: 12rem;
  overflow: hidden;
}

.topology-canvas {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  isolation: isolate;
}

.topology-edges {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: block;
  width: 100%;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
}

.topology-nodes {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: block;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.empty-canvas-hint {
  position: absolute;
  inset: 0;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  font-size: 12px;
  color: var(--text-dim);
}

.diagnostics-panel {
  position: relative;
  z-index: 10;
  width: 360px;
  min-width: 360px;
  height: 100%;
  overflow-y: auto;
  overflow-x: hidden;
}

.diagnostics-panel .panel-header {
  position: sticky;
  top: 0;
  z-index: 2;
}

@media (max-width: 1280px) {
  .netforge-layout.with-diagnostics {
    grid-template-columns: minmax(0, 1fr) 320px;
  }

  .diagnostics-panel {
    width: 320px;
    min-width: 320px;
  }
}

@media (max-width: 1024px) {
  .netforge-layout.with-diagnostics {
    grid-template-columns: minmax(0, 1fr) 280px;
  }

  .diagnostics-panel {
    width: 280px;
    min-width: 280px;
  }
}

/* ============================================================
   Right Dock — Dark Theme + Resizable Split
   Device configuration + AI Assistant
   ============================================================ */

.right-dock {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  width: 100%;
  background: #0a0a0c;
  position: relative;
}

.right-dock-split {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
}

.right-dock-pane {
  min-height: 0;
  overflow: hidden;
}

.right-dock-top {
  background: #0f1115;
  border-bottom: 1px solid #1f2937;
}

.right-dock-divider {
  height: 6px;
  flex: 0 0 6px;
  background: #0a0a0c;
  cursor: ns-resize;
  position: relative;
  transition: background 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.right-dock-divider::before {
  content: '';
  width: 32px;
  height: 3px;
  border-radius: 999px;
  background: #1f2937;
  transition: all 0.2s ease;
}

.right-dock-divider:hover {
  background: #111827;
}

.right-dock-divider:hover::before {
  width: 48px;
  background: #374151;
}

.right-dock-divider:active::before,
.right-dock-divider.dragging::before {
  background: #3b82f6;
}

.right-dock-bottom {
  flex: 1 1 auto;
  min-height: 240px;
  overflow: hidden;
  background: #0a0a0c;
  border-top: 1px solid #1f2937;
  position: relative;
}

/* ============================================================
   Device Configuration Panel
   ============================================================ */

.device-config-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  background: #0f1115;
  color: #e2e8f0;
  font-size: 12px;
}

.device-config-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  border-bottom: 1px solid #1f2937;
  background: #0a0a0c;
}

.device-config-title {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #94a3b8;
}

.device-config-expand,
.device-config-collapse {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border: 0;
  background: #1e293b;
  color: #94a3b8;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.15s ease;
  font-size: 12px;
  font-weight: 700;
}

.device-config-expand:hover,
.device-config-collapse:hover {
  background: #334155;
  color: #e2e8f0;
}

.device-config-body {
  flex: 1 1 auto;
  overflow-y: auto;
  padding: 6px 0;
}

.device-group {
  border-bottom: 1px solid #1f2937;
}

.device-group:last-child {
  border-bottom: 0;
}

.device-group-header {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 8px 12px;
  border: 0;
  background: transparent;
  color: #e2e8f0;
  cursor: pointer;
  transition: all 0.15s ease;
  text-align: left;
}

.device-group-header:hover {
  background: #1e293b;
}

.device-group-name {
  font-size: 12px;
  font-weight: 600;
  color: #f1f5f9;
}

.device-group-type {
  font-size: 10px;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-left: auto;
  padding-right: 4px;
}

.device-interfaces {
  padding: 0 12px 8px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.interface-row {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px 8px;
  background: #0a0a0c;
  border-radius: 6px;
  font-size: 11px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

.interface-row.status-up {
  border-left: 2px solid #10b981;
}

.interface-row.status-down {
  border-left: 2px solid #dc2626;
}

.interface-name {
  color: #94a3b8;
  font-size: 10.5px;
}

.interface-ip {
  color: #e2e8f0;
  font-weight: 500;
}

.interface-mask {
  color: #64748b;
  font-size: 10.5px;
  margin-left: auto;
}

/* ============================================================
   AI Lab Assistant - Dark Theme
   ============================================================ */

.assistant-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  background: #0a0a0c;
  color: #e2e8f0;
  font-size: 12px;
  position: relative;
}

.assistant-header {
  flex: 0 0 auto;
  padding: 8px 10px 6px;
  background: #0f1115;
  border-bottom: 1px solid #1f2937;
  position: relative;
  z-index: 5;
}

.assistant-header-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.assistant-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  border-radius: 8px;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #ffffff;
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.35);
}

.assistant-title {
  font-size: 13px;
  font-weight: 700;
  color: #f1f5f9;
  letter-spacing: -0.01em;
  line-height: 1.2;
}

.assistant-maximize {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border: 0;
  background: transparent;
  color: #64748b;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.15s ease;
  margin-left: auto;
}

.assistant-maximize:hover {
  background: #1e293b;
  color: #e2e8f0;
}

.assistant-toolbar {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 6px;
  min-width: 0;
}

.assistant-mode-switch {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  padding: 2px;
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 999px;
  flex-shrink: 0;
}

.assistant-mode-switch button {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 9px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: #94a3b8;
  background: transparent;
  border: 0;
  border-radius: 999px;
  cursor: pointer;
  transition: all 0.15s ease;
  white-space: nowrap;
}

.assistant-mode-switch button:hover:not(.active) {
  color: #e2e8f0;
}

.assistant-mode-switch button.active {
  background: #2563eb;
  color: #ffffff;
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.4);
}

.assistant-context {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 10.5px;
  color: #64748b;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
}

.assistant-context strong {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 10px;
  font-weight: 600;
  color: #e2e8f0;
  background: #1e293b;
  border: 1px solid #334155;
  border-radius: 5px;
  padding: 1px 6px;
}

.assistant-clear {
  border: 0;
  background: transparent;
  color: #64748b;
  font-size: 10.5px;
  font-weight: 600;
  padding: 3px 7px;
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.15s ease;
  flex-shrink: 0;
}

.assistant-clear:hover:not(:disabled) {
  color: #e2e8f0;
  background: #1e293b;
}

.assistant-clear:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ---------- Chat ---------- */

.assistant-chat {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  padding: 10px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  background: #0a0a0c;
  scrollbar-width: thin;
  scrollbar-color: #1f2937 transparent;
}

.assistant-chat::-webkit-scrollbar { width: 5px; }
.assistant-chat::-webkit-scrollbar-track { background: transparent; }
.assistant-chat::-webkit-scrollbar-thumb { background: #1f2937; border-radius: 3px; }
.assistant-chat::-webkit-scrollbar-thumb:hover { background: #334155; }

.assistant-msg {
  display: flex;
  animation: message-slide-in 0.2s ease-out;
}

@keyframes message-slide-in {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

.assistant-msg.user { justify-content: flex-end; }
.assistant-msg.assistant { justify-content: flex-start; }

.assistant-bubble {
  max-width: 92%;
  padding: 8px 11px;
  border-radius: 10px;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
}

.assistant-bubble.user {
  background: #2563eb;
  color: #ffffff;
  border-bottom-right-radius: 4px;
}

.assistant-bubble.assistant {
  background: #1e293b;
  color: #e2e8f0;
  border-bottom-left-radius: 4px;
  border: 1px soli
